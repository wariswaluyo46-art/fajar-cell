# Salin file ini menjadi .env.local lalu sesuaikan nilainya.
# Variabel berawalan NEXT_PUBLIC_ dikirim ke browser.
# ADMIN_PIN, ADMIN_SESSION_SECRET, dan SUPABASE_SERVICE_ROLE_KEY hanya dibaca di server.

# Nomor WhatsApp admin toko (format internasional, tanpa "+" dan tanpa spasi).
NEXT_PUBLIC_WHATSAPP_NUMBER=6285156069234

# Base URL aplikasi, dipakai saat membuat link produk di pesan WhatsApp.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# PIN login admin, diverifikasi di server oleh /api/admin/login.
# Default mengikuti kebutuhan demo PAS: 123456
ADMIN_PIN=123456

# Secret penandatangan cookie sesi admin (minimal 32 karakter acak).
# Buat dengan: openssl rand -hex 32
ADMIN_SESSION_SECRET=ganti-dengan-secret-acak-minimal-32-karakter

# Google Gemini: asisten belanja pembeli + generator deskripsi produk admin.
# HANYA untuk server; jangan memakai prefix NEXT_PUBLIC_.
# Ambil API key dari Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=ganti-dengan-gemini-api-key
# Model utama. gemini-4-argon memerlukan billing aktif; pada free tier
# kuotanya 0 sehingga permintaan otomatis dialihkan ke model fallback.
GEMINI_MODEL=gemini-4-argon
# Daftar model cadangan (pisahkan dengan koma) saat kuota/model utama gagal.
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite
# Batas waktu per model dalam milidetik (opsional, default 20000).
GEMINI_TIMEOUT_MS=20000

# Project URL Supabase (aman dipublikasikan karena juga dipakai client library
# pada umumnya; aplikasi ini hanya memakainya di server).
# Contoh: https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Service role key dari Project Settings -> API. HANYA untuk server.
# Kunci ini melewati RLS; jangan pernah memakai prefix NEXT_PUBLIC_ dan jangan
# menaruhnya di kode client. Di Vercel, tambahkan sebagai Environment Variable
# untuk Production, Preview, dan Development.
SUPABASE_SERVICE_ROLE_KEY=ganti-dengan-service-role-key-dari-dashboard-supabase
